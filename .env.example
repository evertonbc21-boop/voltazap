# --- Checkout / assinatura ---
# Opção A (mais simples com Wix ou Stripe Payment Links):
# Cole o link de pagamento de cada plano:
# VITE_CHECKOUT_URL_ESSENCIAL=https://...
# VITE_CHECKOUT_URL_PROFISSIONAL=https://...
# VITE_CHECKOUT_URL_PREMIUM=https://...
#
# Opção B (Stripe Checkout na API):
# STRIPE_SECRET_KEY=sk_live_...
# APP_URL=https://www.voltazap.com.br
# Opcional (Price IDs do Stripe Dashboard):
# STRIPE_PRICE_ESSENCIAL=price_...
# STRIPE_PRICE_PROFISSIONAL=price_...
# STRIPE_PRICE_PREMIUM=price_...
#
# Sem A nem B: o botão libera em modo demonstração (só para testar o fluxo).

# --- Supabase (front) ---
# Project Settings → API → Project URL / anon (public) key
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Na Vercel: mesmas variáveis em Project Settings → Environment Variables
#
# Auth: em Authentication → Providers → Email, desative "Confirm email"
# no MVP para o cadastro entrar direto sem link no e-mail.

# Chave da OpenAI (apenas no servidor / Vercel — NÃO use VITE_ no front).
# Em produção: Project Settings → Environment Variables → OPENAI_API_KEY
OPENAI_API_KEY=sk-...

# Opcional (padrão: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp Cloud API (Meta) ---
# Token de verificação do webhook (mesmo valor cadastrado na Meta)
VERIFY_TOKEN=troque-por-um-segredo-longo
# Legado (ainda aceito se VERIFY_TOKEN não existir):
# WHATSAPP_VERIFY_TOKEN=

# App Secret do app Meta (valida X-Hub-Signature-256 no POST). Opcional em sandbox inicial.
# WHATSAPP_APP_SECRET=

# Token de acesso da Cloud API (envio futuro — ainda não usado no MVP wa.me)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Mock de mensagem recebida: POST /api/webhooks/whatsapp/mock
WHATSAPP_MOCK_OPEN=true
# WHATSAPP_MOCK_SECRET=segredo-mock-local

# Typebot (opcional) — encaminha cada inbound para o fluxo
# TYPEBOT_WEBHOOK_URL=https://...
# TYPEBOT_WEBHOOK_SECRET=
